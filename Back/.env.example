# Copie para .env (cp .env.example .env) e troque os valores marcados.
# O .env nao e versionado: cada PC tem o seu.

POSTGRES_DB=whiskers
POSTGRES_USER=whiskers
# Gere uma senha aleatoria: openssl rand -base64 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Segredo que assina o token de login. Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo

# Opcionais (os valores abaixo ja sao o padrao)
# Fuso do Postgres: precisa ser o mesmo do PC que roda a API.
# DB_TIMEZONE=America/Sao_Paulo
# CORS_ORIGINS=http://localhost:4200
# COOKIE_SECURE=false
# COOKIE_SAMESITE=Lax
# UPLOAD_DIR=uploads
# ESTOQUE_MINIMO=5
